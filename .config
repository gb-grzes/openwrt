# ==============================
# Target: Xunison D50 5G
# Base: openwrt branch ipq50xx-xunison-d50
# Kernel: 6.12.x / OpenWrt 25.12
# ==============================

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xunison_exigo-hub-d50-5g=y

# ==============================
# NSS - hardware acceleration
# ==============================
CONFIG_PACKAGE_nss-firmware-ipq50xx=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-clients=y
CONFIG_PACKAGE_kmod-qca-nss-bridge-mgr=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y

# ==============================
# VPN - WireGuard
# ==============================
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# VPN - OpenVPN
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn=y

# ==============================
# Zarządzanie modemem 5G
# ==============================
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_luci-app-sms-tool-js=y
CONFIG_PACKAGE_modeminfo=y
CONFIG_PACKAGE_luci-app-modeminfo=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y

# AT console / diagnostics
CONFIG_PACKAGE_atinout=y
CONFIG_PACKAGE_luci-app-atinout-mod=y

# Quectel wwan (z nss_packages feed)
CONFIG_PACKAGE_quectel-mhi-pcie=y
CONFIG_PACKAGE_quectel-cm=y
CONFIG_PACKAGE_luci-proto-quectel=y
CONFIG_PACKAGE_luci-app-pcimodem=y

# Exigo Hub D50 5G dedykowany panel (4IceG)
CONFIG_PACKAGE_luci-app-exigo-hub-d50-5g=y

# ==============================
# Monitoring / statystyki sieci
# ==============================
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-rrdtool=y

# ==============================
# LuCI - interfejs webowy
# ==============================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-network=y

# ==============================
# Podstawowe narzędzia
# ==============================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables=y

# ==============================
# SSH
# ==============================
CONFIG_PACKAGE_openssh-sftp-server=y
